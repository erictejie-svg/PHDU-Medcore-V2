<!-- ==================================================
     PHDU MEDCORE STYLES
=================================================== -->

<style>

*{

    margin:0;

    padding:0;

    box-sizing:border-box;

}

html,

body{

    width:100%;

    height:100%;

    overflow:hidden;

    background:#02111d;

    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;

}

#app,

#splashScreen{

    position:relative;

    width:100vw;

    height:100vh;

    overflow:hidden;

}

/* ======================================================

   BACKGROUND

====================================================== */

#background{

    position:absolute;

    inset:0;

    width:100%;

    height:100%;

    background-image:url("https://raw.githubusercontent.com/pediatrichighdependency-debug/phdu-medcore-assets/main/background.jpeg");

    background-size:cover;

    background-position:center center;

    background-repeat:no-repeat;

    background-color:#02111d;

    z-index:1;

}

/* ======================================================

   SOFT OVERLAY

====================================================== */

#overlay{

    position:absolute;

    inset:0;

    background:rgba(0,0,0,.03);

    z-index:2;

}

/* ======================================================

   CENTER CONTENT

====================================================== */

#centerContent{

    position:absolute;

    left:50%;

    top:43%;

    transform:translate(-50%,-50%);

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    z-index:10;

}

/* ======================================================

   LOGO

====================================================== */

#logoImage{

    width:320px;

    height:auto;

    cursor:pointer;

    user-select:none;

    -webkit-user-drag:none;

    filter:

        drop-shadow(0 0 18px rgba(0,180,255,.75));

    animation:

        breathe 3s ease-in-out infinite,

        glow 2.5s ease-in-out infinite;

    transition:

        transform .35s ease,

        filter .35s ease;

}

/* ======================================================

   LOGO HOVER

====================================================== */

#logoImage:hover{

    transform:scale(1.05);

}

/* ======================================================

   LOGO TAP

====================================================== */

.logoTapped{

    transform:scale(.95);

}

/* ======================================================

   BREATHING ANIMATION

====================================================== */

@keyframes breathe{

    0%{

        transform:scale(.97);

    }

    50%{

        transform:scale(1.03);

    }

    100%{

        transform:scale(.97);

    }

}

/* ======================================================

   GLOW ANIMATION

====================================================== */

@keyframes glow{

    0%{

        filter:

            drop-shadow(0 0 12px rgba(0,170,255,.55));

    }

    50%{

        filter:

            drop-shadow(0 0 40px rgba(0,170,255,1));

    }

    100%{

        filter:

            drop-shadow(0 0 12px rgba(0,170,255,.55));

    }

}

/* ======================================================

   PREMIUM TAP INDICATOR

====================================================== */

#tapIndicator{

    margin-top:60px;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:8px;

    z-index:20;

    pointer-events:none;

}

#tapIndicator .arrow{

    font-size:120px;

    line-height:.50;

    color:#ffffff;

    font-weight:900;

    margin-bottom:-24px;

    text-shadow:

        0 0 20px rgba(0,170,255,.95),

        0 0 45px rgba(0,170,255,.85),

        0 0 80px rgba(0,170,255,.65);

    animation:

        premiumBounce 1.2s ease-in-out infinite;

}

#tapIndicator .tapText{

    margin-top:24px;

    color:#ffffff;

    font-size:46px;

    font-weight:900;

    letter-spacing:2px;

    text-transform:uppercase;

    padding:22px 48px;

    border-radius:52px;

    background:

        rgba(0,20,40,.68);

    border:

        2px solid rgba(255,255,255,.32);

    backdrop-filter:

        blur(16px);

    -webkit-backdrop-filter:

        blur(16px);

    box-shadow:

        0 14px 34px rgba(0,0,0,.35),

        0 0 24px rgba(0,170,255,.45);

    white-space:nowrap;

    animation:

        premiumFade 2s ease-in-out infinite;

}

@keyframes premiumBounce{

    0%{

        transform:translateY(8px);

        opacity:.55;

    }

    50%{

        transform:translateY(-6px);

        opacity:1;

    }

    100%{

        transform:translateY(8px);

        opacity:.55;

    }

}

@keyframes premiumFade{

    0%{

        opacity:.75;

    }

    50%{

        opacity:1;

    }

    100%{

        opacity:.75;

    }

}

/* ======================================================

   MODULE MENU

====================================================== */

.hiddenMenu{

    display:none;

}

#moduleMenu{

    position:fixed;

    inset:0;

    width:100%;

    height:100%;

    background:

        linear-gradient(

            180deg,

            rgba(4,24,45,.98),

            rgba(5,35,63,.99)

        );

    z-index:9999;

    overflow-y:auto;

    padding:

        calc(env(safe-area-inset-top) + 40px)

        22px

        calc(env(safe-area-inset-bottom) + 30px);

}

#moduleHeader{

    text-align:center;

    margin-bottom:35px;

}

#moduleTitle{

    color:#ffffff;

    font-size:60px;

    font-weight:900;

    letter-spacing:-1px;

}

#moduleSubtitle{

    color:#9ecbff;

    font-size:24px;

    font-weight:600;

    margin-top:12px;

}

#moduleCards{

    display:flex;

    flex-direction:column;

    gap:18px;

}

.moduleCard{

    position:relative;

    overflow:hidden;

    display:flex;

    flex-direction:column;

    justify-content:center;

    gap:12px;

    min-height:180px;

    padding:34px;

    border-radius:28px;

    background:

        linear-gradient(

            135deg,

            rgba(32,52,77,.98),

            rgba(25,43,65,.98)

        );

    border:

        1px solid rgba(70,180,255,.28);

    box-shadow:

        0 18px 45px rgba(0,0,0,.35),

        0 0 25px rgba(0,170,255,.12);

    transition:

        transform .25s ease,

        box-shadow .25s ease,

        border-color .25s ease;

}

.moduleCard::before{

    content:"";

    position:absolute;

    left:0;

    top:0;

    width:12px;

    height:100%;

    background:

        linear-gradient(

            to bottom,

            #56dbff,

            #0099ff

        );

    box-shadow:

        0 0 18px rgba(0,170,255,.70);

}

.moduleCard::after{

    content:"›";

    position:absolute;

    right:28px;

    top:50%;

    transform:

        translateY(-50%);

    font-size:58px;

    color:#6dd5ff;

    font-weight:700;

}

.moduleIcon{

    width:82px;

    height:82px;

    border-radius:50%;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:48px;

    background:

        radial-gradient(

            circle,

            rgba(70,200,255,.35),

            rgba(0,90,180,.15)

        );

    border:

        2px solid rgba(120,220,255,.35);

    box-shadow:

        0 0 20px rgba(0,170,255,.25);

}

.moduleName{

    color:#ffffff;

    font-size:40px;

    font-weight:900;

    margin-top:12px;

    line-height:1.15;

}

.moduleDesc{

    color:#c9def7;

    font-size:24px;

    font-weight:700;

    margin-top:10px;

    line-height:1.3;

}

.moduleCard:active{

    transform:

        scale(.98);

    border-color:

        #5fd2ff;

    box-shadow:

        0 25px 55px rgba(0,170,255,.28);

}

/* ======================================================

   MEDICATION DOSES PAGE

====================================================== */

#medicationDosesPage{

    position:fixed;

    inset:0;

    width:100%;

    height:100%;

    background:

        linear-gradient(

            180deg,

            #08233A 0%,

            #0A2A45 45%,

            #071E32 100%

        );

    z-index:99999;

    overflow-y:auto;

    overflow-x:hidden;

    padding:

        calc(env(safe-area-inset-top) + 25px)

