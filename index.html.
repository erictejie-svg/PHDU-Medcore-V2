}

#searchMedication::placeholder{

    color:#9dc8e8;

    font-size:44px;

    font-weight:700;

}

/* ======================================================

   RECENT SEARCHES

====================================================== */

#recentSection{

    margin-top:24px;

}

#recentSection h2{

    color:#9fdcff;

    font-size:46px;

    font-weight:900;

    margin-bottom:18px;

}

#recentList{

    min-height:80px;

    color:#ffffff;

    font-size:34px;

    font-weight:600;

    margin-top:10px;

    margin-bottom:40px;

}

/* ======================================================

   DRUG LIST

====================================================== */

#drugList{

    min-height:300px;

}

/* ======================================================

   DRUG CARD

====================================================== */

.drugCard{

    position:relative;

    display:flex;

    flex-direction:column;

    justify-content:center;

    overflow:hidden;

    background:

        linear-gradient(

            180deg,

            rgba(24,63,95,.98),

            rgba(15,45,70,.99)

        );

    border:

        2px solid rgba(95,210,255,.28);

    border-radius:34px;

    padding:42px;

    margin-bottom:30px;

    box-shadow:

        0 16px 40px rgba(0,0,0,.35),

        0 0 24px rgba(0,170,255,.12);

    transition:

        transform .20s ease,

        box-shadow .20s ease,

        border-color .20s ease;

}

/* Left Accent */

.drugCard::before{

    content:"";

    position:absolute;

    left:0;

    top:0;

    width:10px;

    height:100%;

    background:

        linear-gradient(

            to bottom,

            #6fe2ff,

            #0099ff

        );

}

/* Right Arrow */

.drugCard::after{

    content:"›";

    position:absolute;

    right:34px;

    top:50%;

    transform:

        translateY(-50%);

    font-size:64px;

    font-weight:900;

    color:#67d8ff;

    opacity:.9;

}

/* Touch Effect */

.drugCard:active{

    transform:

        scale(.985);

    border-color:

        #79dcff;

    box-shadow:

        0 20px 48px rgba(0,170,255,.20);

}

/* ======================================================

   DRUG NAME

====================================================== */

.drugName{

    color:#ffffff;

    font-size:58px;

    font-weight:900;

    letter-spacing:-0.6px;

    line-height:1.1;

}

/* ======================================================

   DRUG CATEGORY

====================================================== */

.drugCategory{

    margin-top:22px;

    color:#76d9ff;

    font-size:34px;

    font-weight:800;

    line-height:1.4;

}

/* ======================================================

   DRUG ROUTE

====================================================== */

.drugRoute{

    margin-top:14px;

    color:#e4f4ff;

    font-size:30px;

    font-weight:700;

    line-height:1.5;

}

/* ======================================================

   DRUG DETAILS PAGE

====================================================== */

#drugDetailsPage{

    position:fixed;

    inset:0;

    width:100%;

    height:100%;

    background:

        linear-gradient(

            180deg,

            #08233A 0%,

            #0A2A45 45%,

            #071E32 100%

        );

    z-index:999999;

    overflow-y:auto;

    overflow-x:hidden;

    padding:

        calc(env(safe-area-inset-top) + 28px)

        20px

        calc(env(safe-area-inset-bottom) + 40px);

    -webkit-overflow-scrolling:

        touch;

}

/* ======================================================

   DRUG DETAILS HEADER

====================================================== */

#drugDetailsHeader{

    display:flex;

    align-items:center;

    gap:26px;

    margin-bottom:40px;

}

#drugBackButton{

    background:none;

    border:none;

    color:#74d8ff;

    font-size:56px;

    font-weight:900;

    cursor:pointer;

    padding:12px 6px;

}

#detailDrugName{

    color:#ffffff;

    font-size:74px;

    font-weight:900;

    letter-spacing:-1px;

    line-height:1.05;

    text-shadow:

        0 3px 12px rgba(0,0,0,.25);

}

/* ======================================================

   DRUG DETAILS BODY

====================================================== */

#drugDetailsBody{

    display:flex;

    flex-direction:column;

    gap:28px;

}

/* ======================================================

   DETAIL CARD

====================================================== */

.detailCard{

    position:relative;

    overflow:hidden;

    background:

        linear-gradient(

            180deg,

            rgba(24,63,95,.98),

            rgba(15,45,70,.99)

        );

    border:

        2px solid rgba(95,210,255,.25);

    border-radius:36px;

    padding:44px;

    box-shadow:

        0 18px 42px rgba(0,0,0,.35),

        0 0 24px rgba(0,170,255,.12);

}

/* ======================================================

   CLINICAL DOSING GUIDE CARD

   Only the third card becomes a light clinical

   reading panel.

   Classification and Route remain unchanged.

====================================================== */

#drugDetailsBody .detailCard:nth-child(3){

    background:

        linear-gradient(

            180deg,

            #FFFFFF 0%,

            #F8FBFD 100%

        );

    border:

        2px solid #D5E7F1;

    padding:56px;

    box-shadow:

        0 20px 48px rgba(0,0,0,.22),

        0 0 28px rgba(0,170,255,.16);

}

/* ======================================================

   DETAIL CARD LEFT ACCENT

====================================================== */

.detailCard::before{

    content:"";

    position:absolute;

    left:0;

    top:0;

    width:8px;

    height:100%;

    background:

        linear-gradient(

            to bottom,

            #68DEFF,

            #009DFF

        );

}

/* ======================================================

   CLINICAL DOSING GUIDE GOLD ACCENT

====================================================== */

#drugDetailsBody .detailCard:nth-child(3)::before{

    width:10px;

    background:

        linear-gradient(

            to bottom,

            #FFE06A,

            #F2A900

        );

    box-shadow:

        0 0 18px rgba(242,169,0,.36);

}

/* ======================================================

   DETAIL TITLE

====================================================== */

.detailTitle{

    color:#79DBFF;

    font-size:40px;

    font-weight:900;

    letter-spacing:.5px;

    text-transform:uppercase;

    margin-bottom:24px;

}

/* ======================================================

   CLINICAL DOSING GUIDE TITLE

   Distinct amber heading:

   - separate from green pediatric highlighting

   - separate from blue adult highlighting

====================================================== */

#drugDetailsBody .detailCard:nth-child(3) .detailTitle{

    display:inline-block;

    color:#4A3100;

    background:

        linear-gradient(

            180deg,

            #FFF1A8 0%,

            #FFD45A 100%

        );

    font-size:46px;

    font-weight:900;

    line-height:1.15;

    letter-spacing:.7px;

    padding:

        17px 25px;

    margin-bottom:36px;

    border:

        2px solid #E5A900;

    border-radius:18px;

    box-shadow:

        0 8px 18px rgba(160,105,0,.20),

        0 0 15px rgba(255,200,45,.25);

}

/* ======================================================

   DETAIL VALUE

====================================================== */

.detailValue{

    color:#FFFFFF;

    font-size:54px;

    font-weight:800;

    line-height:1.45;

    letter-spacing:-0.3px;

    word-break:break-word;

}

/* ======================================================

   CLINICAL DOSING GUIDE TEXT

   Rich-text formatting from Drug Master remains active:

   - black standard clinical text

   - green pediatric content

   - blue adult content

====================================================== */

#detailOriginalEntry{

    color:#111111;

    font-size:54px;

    font-weight:700;

    line-height:1.65;

    letter-spacing:-0.3px;

    white-space:pre-wrap;

    word-break:break-word;

    overflow-wrap:anywhere;

}


/* ======================================================
   CROSS-REFERENCE MEDICATION CARD
   PHDU MEDCORE — PREMIUM MOBILE ACTION CARD
====================================================== */

.hiddenCrossReference{

    display:none !important;

}


/* ======================================================
   MAIN CARD
====================================================== */

.drugCrossReference{

    position:relative;

    display:flex;

    align-items:center;

    gap:24px;

    width:100%;

    min-height:200px;

    margin-top:150px;

    padding:
        30px
        82px
        30px
        34px;

    border-radius:30px;

    cursor:pointer;

    user-select:none;

    -webkit-user-select:none;

    -webkit-tap-highlight-color:transparent;

    overflow:hidden;

    background:
        linear-gradient(
            135deg,
            #126AAE 0%,
            #0A4B82 50%,
            #07345E 100%
        );

    border:3px solid #67D8FF;

    box-shadow:
        0 18px 38px rgba(0,0,0,.28),
        0 0 26px rgba(70,205,255,.30);

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease;

}


/* ======================================================
   LEFT ACCENT
====================================================== */

.drugCrossReference::before{

    content:"";

    position:absolute;

    left:0;

    top:0;

    width:12px;

    height:100%;

    background:
        linear-gradient(
            to bottom,
            #A4F0FF,
            #39C8FF,
            #0099FF
        );

    box-shadow:
        0 0 22px rgba(80,220,255,.78);

}


/* ======================================================
   SUBTLE TOP SHINE
====================================================== */

.drugCrossReference::after{

    content:"";

    position:absolute;

    left:18px;

    right:18px;

    top:0;

    height:2px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.65),
            transparent
        );

    opacity:.75;

}


/* ======================================================
   TAP STATE
====================================================== */

.drugCrossReference:active{

    transform:scale(.985);

    border-color:#C7F5FF;

    box-shadow:
        0 12px 28px rgba(0,0,0,.32),
        0 0 34px rgba(80,220,255,.48);

}


/* ======================================================
   HOVER STATE
====================================================== */

.drugCrossReference:hover{

    transform:translateY(-2px);

    border-color:#B9F2FF;

    box-shadow:
        0 24px 44px rgba(0,0,0,.30),
        0 0 36px rgba(80,220,255,.44);

}


/* ======================================================
   KEYBOARD FOCUS
====================================================== */

.drugCrossReference:focus-visible{

    outline:4px solid #FFD45A;

    outline-offset:6px;

}


/* ======================================================
   ICON
====================================================== */

.crossReferenceIcon{

    position:relative;

    z-index:2;

    flex:0 0 auto;

    display:flex;

    align-items:center;

    justify-content:center;

    width:82px;

    height:82px;

    border-radius:24px;

    color:#052A44;

    font-size:54px;

    font-weight:900;

    line-height:1;

    background:
        linear-gradient(
            180deg,
            #E4FBFF 0%,
            #A5E9FF 55%,
            #76D7FF 100%
        );

    border:2px solid rgba(255,255,255,.82);

    box-shadow:
        0 10px 20px rgba(0,0,0,.22),
        0 0 20px rgba(110,225,255,.40);

}


/* ======================================================
   TEXT WRAPPER
====================================================== */

.crossReferenceContent{

    position:relative;

    z-index:2;

    flex:1;

    min-width:0;

}


/* ======================================================
   LABEL
====================================================== */

.crossReferenceLabel{

    color:#C8F2FF;

    font-size:26px;

    font-weight:900;

    letter-spacing:1.15px;

    line-height:1.2;

    text-transform:uppercase;

    margin-bottom:12px;

    text-shadow:
        0 2px 8px rgba(0,0,0,.20);

}


/* ======================================================
   REFERENCED DRUG NAME
====================================================== */

.crossReferenceDrugName{

    color:#FFFFFF;

    font-size:44px;

    font-weight:900;

    line-height:1.18;

    letter-spacing:-.45px;

    overflow-wrap:anywhere;

    word-break:break-word;

    text-shadow:
        0 3px 10px rgba(0,0,0,.26);

}


/* ======================================================
   RIGHT ARROW
====================================================== */

.crossReferenceArrow{

    position:absolute;

    right:28px;

    top:50%;

    transform:translateY(-50%);

    z-index:2;

    color:#A2E9FF;

    font-size:72px;

    font-weight:900;

    line-height:1;

    text-shadow:
        0 0 16px rgba(80,220,255,.58);

}


/* ======================================================
   SMALLER MOBILE WIDTH
====================================================== */

@media (max-width:480px){

    .drugCrossReference{

        gap:18px;

        min-height:142px;

        padding:
            26px
            70px
            26px
            28px;

        border-radius:26px;

    }

    .crossReferenceIcon{

        width:70px;

        height:70px;

        border-radius:20px;

        font-size:46px;

