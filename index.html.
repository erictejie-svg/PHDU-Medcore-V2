        touch;

}

#medicationHeader{

    display:flex;

    align-items:center;

    gap:18px;

    margin-bottom:28px;

}

#medicationHeader button{

    background:none;

    border:none;

    color:#7fd3ff;

    font-size:48px;

    font-weight:900;

    cursor:pointer;

    padding:0;

    line-height:1;

}

#medicationHeader h1{

    color:#ffffff;

    font-size:60px;

    font-weight:900;

    line-height:1.1;

}

/* ======================================================

   MEDICATION SEARCH

====================================================== */

#medicationSearch{

    position:relative;

    margin-bottom:42px;

}

#searchIcon{

    position:absolute;

    left:34px;

    top:50%;

    transform:

        translateY(-50%);

    font-size:42px;

    color:#9fdcff;

    pointer-events:none;

    z-index:2;

}

#searchMedication{

    width:100%;

    height:120px;

    padding:

        0 40px 0 100px;

    border:none;

    outline:none;

    border-radius:30px;

    background:

        linear-gradient(

            180deg,

            #183c5f,

            #10314d

        );

    color:#ffffff;

    font-size:40px;

    font-weight:800;

    letter-spacing:.3px;

    border:

        2px solid rgba(95,210,255,.28);

