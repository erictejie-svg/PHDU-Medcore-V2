        <div id="drugDetailsPage" class="hiddenMenu">

    <!-- ==================================================
         HEADER
    =================================================== -->

    <div id="drugDetailsHeader">

        <button
            id="drugBackButton"
            type="button"
            onclick="closeDrugDetails()"
            aria-label="Back to medication search">

            ← Back

        </button>

        <h1 id="detailDrugName">
            Drug Name
        </h1>

        <!-- ==============================================
             TEMPORARY EDIT BUTTON
        =============================================== -->

        <button
            id="openDrugEditorButton"
            type="button"
            onclick="openTemporaryDrugEditor()"
            aria-label="Edit this medication">

            ✎ Edit

        </button>

    </div>

    <!-- ==================================================
         BODY
    =================================================== -->

    <div id="drugDetailsBody">

        <!-- ==============================================
             CLASSIFICATION
        =============================================== -->

        <div class="detailCard">

            <div class="detailTitle">
                Classification
            </div>

            <div
                id="detailClassification"
                class="detailValue">

                -

            </div>

        </div>

        <!-- ==============================================
             ROUTE
        =============================================== -->

        <div class="detailCard">

            <div class="detailTitle">
                Route
            </div>

            <div
                id="detailRoute"
                class="detailValue">

                -

            </div>

        </div>

        <!-- ==============================================
             CLINICAL DOSING GUIDE
        =============================================== -->

        <div class="detailCard">

            <div class="detailTitle">
                Clinical Dosing Guide
            </div>

            <div
                id="detailOriginalEntry"
                class="detailValue">

                -

            </div>

            <!-- ==========================================
                 REFERENCED MEDICATION ACTION CARD

                 Hidden by default.

                 DrugFunctions.html displays this only
                 when the Clinical Dosing Guide begins with
                 a valid "See ..." medication reference.
            =========================================== -->

            <div
                id="drugCrossReference"
                class="drugCrossReference hiddenCrossReference"
                role="button"
                tabindex="0"
                aria-label="Open referenced medication"
                aria-hidden="true">

                <div
                    class="crossReferenceIcon"
                    aria-hidden="true">

                    ↗

                </div>

                <div class="crossReferenceContent">

                    <div class="crossReferenceLabel">
                        Open Referenced Medication
                    </div>

                    <div
                        id="crossReferenceDrugName"
                        class="crossReferenceDrugName">

                        Medication Name

                    </div>

                </div>

                <div
                    class="crossReferenceArrow"
                    aria-hidden="true">

                    ›

                </div>

            </div>

        </div>

    </div>

    <!-- ==================================================
         TEMPORARY PASSWORD-PROTECTED DRUG EDITOR
    =================================================== -->

    <div
        id="drugEditorOverlay"
        class="hiddenDrugEditor"
        aria-hidden="true">

        <div
            id="drugEditorPanel"
            role="dialog"
            aria-modal="true"
            aria-labelledby="drugEditorTitle">

            <!-- ==========================================
                 EDITOR HEADER
            =========================================== -->

            <div id="drugEditorHeader">

                <div>

                    <div id="drugEditorTitle">
                        Edit Medication
                    </div>

                    <div id="drugEditorSubtitle">
                        Temporary Drug Master editor
                    </div>

                </div>

                <button
                    id="closeDrugEditorButton"
                    type="button"
                    onclick="closeTemporaryDrugEditor()"
                    aria-label="Close medication editor">

                    ×

                </button>

            </div>

            <!-- ==========================================
                 EDITOR BODY
            =========================================== -->

            <div id="drugEditorBody">

                <!-- ======================================
                     DRUG NAME
                     Locked to prevent duplicate records
                ======================================= -->

                <div class="drugEditorField">

                    <label for="editDrugName">
                        Drug Name
                    </label>

                    <input
                        id="editDrugName"
                        type="text"
                        readonly
                        aria-readonly="true">

                    <div class="drugEditorHelp">

                        Drug Name is locked to prevent
                        duplicate or incorrect records.

                    </div>

                </div>

                <!-- ======================================
                     CLASSIFICATION
                ======================================= -->

                <div class="drugEditorField">

                    <label for="editClassification">
                        Classification
                    </label>

                    <input
                        id="editClassification"
                        type="text"
                        autocomplete="off"
                        autocorrect="off"
                        autocapitalize="sentences"
                        spellcheck="true">

                </div>

                <!-- ======================================
                     ROUTE
                ======================================= -->

                <div class="drugEditorField">

                    <label for="editRoute">
                        Route
                    </label>

                    <input
                        id="editRoute"
                        type="text"
                        autocomplete="off"
                        autocorrect="off"
                        autocapitalize="sentences"
                        spellcheck="true">

                </div>

                <!-- ======================================
                     CLINICAL DOSING GUIDE
                ======================================= -->

                <div class="drugEditorField">

                    <label for="editOriginalEntry">
                        Clinical Dosing Guide
                    </label>

                    <textarea
                        id="editOriginalEntry"
                        autocomplete="off"
                        autocorrect="off"
                        autocapitalize="sentences"
                        spellcheck="true"></textarea>

                    <div class="drugEditorWarning">

                        Review all spelling, doses, units,
                        routes, abbreviations, spacing, and
                        line breaks carefully before saving.

                    </div>

                    <div class="drugEditorWarning">

                        Editing the Clinical Dosing Guide
                        replaces the current Google Sheets
                        rich-text formatting. The approved
                        Drug Master rich-text formatter must
                        be run again afterward.

                    </div>

                </div>

                <!-- ======================================
                     PASSWORD
                ======================================= -->

                <div class="drugEditorField">

                    <label for="drugEditorPassword">
                        Editing Password
                    </label>

                    <input
                        id="drugEditorPassword"
                        type="password"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        maxlength="1"
                        autocomplete="off"
                        placeholder="Enter password">

                </div>

                <!-- ======================================
                     SAVE STATUS
                ======================================= -->

                <div
                    id="drugEditorStatus"
                    role="status"
                    aria-live="polite">

                </div>

            </div>

            <!-- ==========================================
                 EDITOR ACTIONS
            =========================================== -->

            <div id="drugEditorActions">

                <button
                    id="cancelDrugEditorButton"
                    type="button"
                    onclick="closeTemporaryDrugEditor()">

                    Cancel

                </button>

                <button
                    id="saveDrugEditorButton"
                    type="button"
                    onclick="saveTemporaryDrugEditor()">

                    Save Changes

                </button>

            </div>

        </div>

    </div>

</div>


